# Copy to server/.env and fill in MONGODB_URI + JWT_SECRET.

# MongoDB Atlas connection string. Free M0 cluster is enough.
# Remember to URL-encode the password if it contains @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/support_sla?retryWrites=true&w=majority

# Any random string of 16+ characters.
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=7d

PORT=4000
NODE_ENV=development

# Origin allowed to send the auth cookie. The Next.js dev server.
WEB_ORIGIN=http://localhost:3000

# IANA timezone the business-hours windows are expressed in.
SLA_TIMEZONE=Asia/Karachi

# Breach sweep schedule. Set SLA_SWEEP_ENABLED=0 to turn it off while seeding.
SLA_SWEEP_CRON=*/1 * * * *
SLA_SWEEP_ENABLED=1

# Shared secret for POST /api/jobs/sla-sweep, used by an external scheduler.
# Set SLA_SWEEP_ENABLED=0 in serverless or multi-instance deployments and drive
# the sweep from that endpoint instead of the in-process cron.
CRON_SECRET=generate-a-long-random-string

# Number of proxy hops in front of the app. 1 on Vercel/Render/Railway/Fly.
TRUST_PROXY=0

# "lax" when the UI proxies /api through itself (recommended). "none" only if
# the browser calls the API on a different site — and that requires HTTPS.
COOKIE_SAMESITE=lax
